---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 | Etter Digital"
  description="The requested page could not be found."
>
  <section class="error-page">
    <div class="error-orb error-orb-one"></div>
    <div class="error-orb error-orb-two"></div>

    <div class="container error-layout">
      <div class="error-copy">
        <p class="eyebrow">System Response / 404</p>

        <div class="error-status mono">
          <span></span>
          ROUTE NOT FOUND
        </div>

        <h1>
          Lost in the
          <br />
          <span>network.</span>
        </h1>

        <p class="error-description">
          The page you requested does not exist, may have moved, or is no
          longer available.
        </p>

        <div class="error-actions">
          <a class="primary-action" href="/">
            Return Home
            <span>→</span>
          </a>

          <a class="secondary-action" href="/#projects">
            Browse Projects
            <span>→</span>
          </a>
        </div>
      </div>

      <div class="terminal-shell">
        <div class="terminal-topbar">
          <div class="terminal-dots">
            <span></span>
            <span></span>
            <span></span>
          </div>

          <span class="mono">
            etterdigital.dev / diagnostic
          </span>

          <span class="terminal-state mono">
            ERROR
          </span>
        </div>

        <div class="terminal-body mono">
          <p>
            <span>01</span>
            $ request route
          </p>

          <p>
            <span>02</span>
            resolving path...
          </p>

          <p>
            <span>03</span>
            checking application routes
          </p>

          <p class="terminal-error">
            <span>04</span>
            route_not_found
          </p>

          <p>
            <span>05</span>
            HTTP 404
          </p>

          <p class="terminal-cursor">
            <span>06</span>
            waiting for input_
          </p>
        </div>

        <div class="terminal-footer">
          <span class="mono">
            STATUS / 404
          </span>

          <span class="mono">
            HOST / ETTER DIGITAL
          </span>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .error-page {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
    padding: 7rem 0;
  }

  .error-orb {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none;
  }

  .error-orb-one {
    top: 10%;
    left: 10%;
    width: 34rem;
    height: 34rem;
    background: rgba(100, 72, 255, 0.12);
  }

  .error-orb-two {
    right: -12rem;
    bottom: 0;
    width: 34rem;
    height: 34rem;
    background: rgba(62, 98, 220, 0.06);
  }

  .error-layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 7rem;
    align-items: center;
  }

  .error-copy {
    min-width: 0;
  }

  .error-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.5rem 0;
    color: #9986c6;
    font-size: 0.52rem;
  }

  .error-status span {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #8b6cff;
    box-shadow: 0 0 10px rgba(139, 108, 255, 0.6);
  }

  h1 {
    margin: 0;
    font-size: clamp(5rem, 10vw, 9.5rem);
    line-height: 0.82;
    letter-spacing: -0.08em;
    text-transform: uppercase;
  }

  h1 span {
    color: #786a99;
  }

  .error-description {
    max-width: 560px;
    margin-top: 2rem;
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.85rem 1.1rem;
    border-radius: 8px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .primary-action {
    border: 1px solid rgba(124, 92, 255, 0.65);
    background: rgba(124, 92, 255, 0.11);
  }

  .secondary-action {
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .primary-action:hover,
  .secondary-action:hover {
    transform: translateY(-2px);
    border-color: rgba(124, 92, 255, 0.65);
    color: white;
  }

  .terminal-shell {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(124, 92, 255, 0.22);
    border-radius: 14px;
    background: #080a0f;
    box-shadow:
      0 35px 100px rgba(0, 0, 0, 0.45),
      0 0 70px rgba(100, 72, 255, 0.07);
  }

  .terminal-topbar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 46px;
    padding: 0 1rem;
    border-bottom: 1px solid var(--border);
    color: #646c78;
    font-size: 0.48rem;
  }

  .terminal-dots {
    display: flex;
    gap: 0.4rem;
  }

  .terminal-dots span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #363b45;
  }

  .terminal-dots span:first-child {
    background: #7656ff;
  }

  .terminal-state {
    justify-self: end;
    color: #a682ff;
  }

  .terminal-body {
    padding: 2rem;
    font-size: 0.68rem;
    line-height: 2;
  }

  .terminal-body p {
    display: grid;
    grid-template-columns: 38px 1fr;
    margin: 0;
    color: #848b98;
  }

  .terminal-body p > span {
    color: #454b57;
  }

  .terminal-error {
    color: #aa87ff !important;
  }

  .terminal-cursor {
    color: #a293ff !important;
  }

  .terminal-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    border-top: 1px solid var(--border);
    color: #565d69;
    font-size: 0.46rem;
  }

  @media (max-width: 1000px) {
    .error-layout {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
  }

  @media (max-width: 680px) {
    .error-page {
      min-height: auto;
      padding: 5rem 0;
    }

    h1 {
      font-size: clamp(4rem, 19vw, 6rem);
    }

    .error-actions {
      flex-direction: column;
    }

    .primary-action,
    .secondary-action {
      width: 100%;
    }

    .terminal-topbar {
      grid-template-columns: 1fr auto;
    }

    .terminal-topbar > span:nth-child(2) {
      display: none;
    }

    .terminal-footer {
      flex-direction: column;
    }
  }
</style>